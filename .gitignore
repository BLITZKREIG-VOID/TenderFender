# No trailing slash: also matches a .venv symlink (worktrees), not only a directory.
venv
.venv
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.cache/
artifacts/*
!artifacts/decisions/
.env
.env.*
*.pem
*.key
build/
ui/dist/

# Local source texts for passage checking (licence may forbid redistribution)
kb/sources/*
!kb/sources/README.md
!kb/sources/index.json
