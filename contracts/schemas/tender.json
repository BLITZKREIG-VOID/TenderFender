{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenderfender/contracts/tender.json",
  "title": "data/tenders/T-00x.json (SoT 7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tender_id", "title", "clauses"],
  "properties": {
    "tender_id": {"type": "string", "pattern": "^T-\\d{3}$"},
    "title": {"type": "string", "minLength": 1},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "text"],
        "properties": {
          "clause_id": {"type": "string", "pattern": "^CL\\d+$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
