{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenderfender/contracts/labels.json",
  "title": "data/labels.json (SoT 7) - evaluation only",
  "type": "object",
  "additionalProperties": false,
  "required": ["rings", "vendor_labels", "planted_type"],
  "properties": {
    "rings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ring_id", "vendor_ids", "type"],
        "properties": {
          "ring_id": {"type": "string", "pattern": "^R-\\d+$"},
          "vendor_ids": {"type": "array", "items": {"type": "string", "pattern": "^V-\\d{3}$"}, "minItems": 1},
          "type": {"type": "string", "minLength": 1}
        }
      }
    },
    "vendor_labels": {
      "type": "object",
      "propertyNames": {"pattern": "^V-\\d{3}$"},
      "additionalProperties": {"enum": [0, 1]}
    },
    "planted_type": {
      "type": "object",
      "propertyNames": {"pattern": "^V-\\d{3}$"},
      "additionalProperties": {"enum": ["shell_ring", "rotation", "cover", "none"]}
    }
  }
}
