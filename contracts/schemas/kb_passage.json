{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenderfender/contracts/kb_passage.json",
  "title": "kb/passages/KB-xxx.md front matter (SoT 7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["passage_id", "source_title", "source_url", "section", "retrieved", "topics"],
  "properties": {
    "passage_id": {"type": "string", "pattern": "^KB-\\d{3}$"},
    "source_title": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "topics": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
