{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenderfender/contracts/real_tender.json",
  "title": "data/real/tenders/RT-xxx.json (SoT 7, CC-05)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tender_id", "title", "source_portal", "source_url", "source_ref", "retrieved", "clauses"],
  "properties": {
    "tender_id": {"type": "string", "pattern": "^RT-\\d{3}$"},
    "title": {"type": "string", "minLength": 1},
    "source_portal": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "source_clause_no", "text"],
        "properties": {
          "clause_id": {"type": "string", "pattern": "^CL\\d+$"},
          "source_clause_no": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "needs_review": {"type": "boolean"}
        }
      }
    }
  }
}
